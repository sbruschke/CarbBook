{
  "description": "Shared number-entry rules for web (web/src/ui/format.ts) and iOS (NumberParsing). amount = food/meal amounts, label amounts, portion quantities, servings. bg = manual BG in mg/dL (whole numbers only). Fractions exact: value = numerator / denominator.",
  "tolerance": 1e-12,
  "amount": {
    "accept": [
      { "text": "1", "value": 1 },
      { "text": "0", "value": 0 },
      { "text": "1.5", "value": 1.5 },
      { "text": " 2.25 ", "value": 2.25 },
      { "text": ".5", "value": 0.5 },
      { "text": "1,5", "value": 1.5 },
      { "text": "1/3", "value": 0.3333333333333333 },
      { "text": "2/3", "value": 0.6666666666666666 },
      { "text": "3/4", "value": 0.75 },
      { "text": "0/3", "value": 0 },
      { "text": "4/3", "value": 1.3333333333333333 },
      { "text": "12/16", "value": 0.75 },
      { "text": "1 1/2", "value": 1.5 },
      { "text": "2 2/3", "value": 2.6666666666666665 },
      { "text": "½", "value": 0.5 },
      { "text": "⅓", "value": 0.3333333333333333 },
      { "text": "⅔", "value": 0.6666666666666666 },
      { "text": "¼", "value": 0.25 },
      { "text": "¾", "value": 0.75 },
      { "text": "⅛", "value": 0.125 },
      { "text": "1½", "value": 1.5 },
      { "text": "1 ½", "value": 1.5 },
      { "text": "2⅔", "value": 2.6666666666666665 }
    ],
    "reject": ["", " ", "-1", "1/0", "0/0", "/3", "1/", "1//3", "3/2/1", "1/-3", "1.5/2", "1 1", "1 1/0", "½½", "0x10", "1e3", "Infinity", "NaN", "abc", "1.2.3", "1,5,0", "1 ,5", "11/2", "13/4", "10/3", "1 3/2", "2 4/4", ""]
  },
  "bg": {
    "accept": [
      { "text": "120", "value": 120 },
      { "text": " 85 ", "value": 85 },
      { "text": "0", "value": 0 }
    ],
    "reject": ["", "120.5", "1/2", "½", "12O", "1,200", "-5", "1e2", "0x64"]
  }
}
